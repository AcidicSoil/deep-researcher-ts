{
  "name": "ollama-deep-researcher",
  "version": "0.0.1",
  "description": "Lightweight web research and summarization assistant.",
  "packageManager": "yarn@4.6.0",
  "main": "src/agent/graph.ts",
  "author": "Pascal Euhus <pacoVK>",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=20.11.1"
  },
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build src/ui",
    "build:all": "yarn build && yarn build:ui",
    "clean": "rm -rf dist",
    "dev:server": "bash run-server.sh",
    "dev:ui": "vite src/ui",
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:ui\"",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "jest --testPathPattern=\\.test\\.ts\\$ --testPathIgnorePatterns=\\.int\\.test\\.ts\\$",
    "test:int": "jest --testPathPattern=\\.int\\.test\\.ts\\$",
    "format": "prettier --write .",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "lint:langgraph-json": "node scripts/checkLanggraphPaths.js",
    "lint:all": "yarn lint & yarn lint:langgraph-json & yarn format:check",
    "test:all": "yarn test && yarn test:int && yarn lint:langgraph"
  },
  "dependencies": {
    "@langchain/core": "^0.3.37",
    "@langchain/langgraph": "^0.2.43",
    "@langchain/ollama": "^0.1.5",
    "@tavily/core": "^0.0.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.1",
    "@tsconfig/recommended": "^1.0.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.34.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.5"
  }
}
