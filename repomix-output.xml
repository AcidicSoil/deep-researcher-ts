      </div>

      {results.sources.length > 0 && (
        <div className="bg-white rounded-lg shadow-md p-6">
          <h2 className="text-xl font-bold mb-4">Sources</h2>
          <ul className="space-y-4">
            {results.sources.map((source, index) => (
